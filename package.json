{
  "name": "sender-immersive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sender — sitio inmersivo. Tecnología que transmite.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/seo.mjs",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "node scripts/serve-pages.mjs",
    "lint": "tsc --noEmit && node qa/check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/qa.mjs",
    "test:watch": "node scripts/qa.mjs",
    "audit:palette": "python3 scripts/audit_palette.py",
    "qa": "node scripts/qa.mjs",
    "seo": "node scripts/seo.mjs",
    "lighthouse": "lhci autorun",
    "a11y": "node scripts/a11y-check.js",
    "mobile-check": "node scripts/mobile-check.js",
    "schema-check": "node scripts/schema-check.js",
    "shots": "node scripts/shots.mjs",
    "analyze": "vite build",
    "assets:fetch": "node scripts/fetch_product_images.mjs",
    "build:pages": "VITE_BASE_PATH=/sender-immersive/ VITE_SITE_URL=https://cristianoleamiranda-dotcom.github.io/sender-immersive npm run build",
    "clean": "rm -rf .next out dist .turbo node_modules/.cache"
  },
  "dependencies": {
    "@14islands/r3f-scroll-rig": "^2.0.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three-story-controls": "^1.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
