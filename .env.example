# ==========================================
# SENDER Immersive - Environment Variables
# ==========================================

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Formspree / Netlify Forms (contacto)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Contentful / CMS (si se migra contenido)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Search (Algolia)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=

# Deployment
NEXT_PUBLIC_SITE_URL=https://sender.cl
NEXT_PUBLIC_SITE_NAME=SENDER
VITE_SITE_URL=https://cristianoleamiranda-dotcom.github.io/sender-immersive
VITE_BASE_PATH=/

# Feature Flags
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_VIDEO_FALLBACK=true
